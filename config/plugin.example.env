# ~/.cognee/.env  (chmod 600). Read by the cognee-memory plugin. Values = spec 21.4 (the ones running today).
# seed.sh machine creates this file without the two marked lines (they are added separately) and the key with mint_mcp_key.py plugin.
COGNEE_BACKEND=cloud                      # HTTP client mode; does not install a local runtime
COGNEE_BASE_URL="http://127.0.0.1:45874"
COGNEE_MANAGED_ENDPOINT=true              # if the stack goes down: OFFLINE, it does not start its own server
COGNEE_API_KEY="<created with scripts/mint_mcp_key.py plugin>"      # (omitted when copying)
COGNEE_PLUGIN_DATASET=<project>_sessions                           # (omitted when copying; one per project)
COGNEE_UPDATE_CHECK=false
COGNEE_CODE_AUTOINDEX=off                 # with loopback the plugin treats it as "local" and would index the repo
COGNEE_FILE_CONTEXT=false
# Token savings: bounded per-prompt injection and no automatic improvements
COGNEE_AUTO_IMPROVE_EVERY=0
COGNEE_INJECT_MAX_CHARS=3000
COGNEE_RECALL_PASSAGE_CHARS=600
# Session continuity without queries: don't steal native memory or push to always query
COGNEE_DISABLE_AUTO_MEMORY=false
COGNEE_PREFER_MEMORY=false
# Session capture ON with cost caps on the server (spec 20.1). false = turn it off completely.
COGNEE_CAPTURE=true
